# ==============================================================================
# Образец заполнения env файла, требуется хранить рядом с docker-compose
# ------------------------------------------------------------------------------
# Со значениями из файла работают docker-compose и автотесты
# ==============================================================================

# ==============================================================================
# GITEA: Админ и базовые URL
# ==============================================================================

# Имя пользователя администратора (создается при первом запуске)
GITEA_ADMIN_LOGIN=admin_login

# Пароль администратора (минимум 6 символов)
GITEA_ADMIN_PASSWORD=admin_password

# Почта администратора (минимум 1 символ, обязательное наличие @ и домена)
GITEA_ADMIN_EMAIL=admin@gitea.com

# Базовый URL для веб-интерфейса (UI) Gitea.
# Используется для генерации ссылок, редиректов и отображения в браузере.
GITEA_UI_URL=http://localhost:3000

# Базовый URL для запросов к API Gitea.
# По умолчанию все эндпоинты API находятся по пути /api/v1 относительно UI.
GITEA_API_URL=http://localhost:3000/api/v1

# ==============================================================================
# База данны
# ==============================================================================

# Имя БД, пользователя и пароль
# Требуются для создания и подключения
DATABASE_NAME=gitea_database
DATABASE_USER=gitea_database_user
DATABASE_PASSWORD=gitea_database_password

# ==============================================================================
# Права доступа (UID и GID пользователя)
# ==============================================================================

USER_UID=1000
USER_GID=1000