# ==============================================================================
# GITEA CONFIGURATION
# ==============================================================================

# Имя пользователя администратора (создается при первом запуске)
GITEA_ADMIN_LOGIN=admin_login

# Пароль администратора (минимум 6 символов)
GITEA_ADMIN_PASSWORD=admin_password

# Токен администратора для доступа к API (Personal Access Token)
# Формат: 40-значная шестнадцатеричная строка (hex), например: a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2
GITEA_ADMIN_TOKEN=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2

# Базовый URL для веб-интерфейса (UI) Gitea.
# Используется для генерации ссылок, редиректов и отображения в браузере.
GITEA_UI_URL=http://localhost:3000

# Базовый URL для запросов к API Gitea.
# По умолчанию все эндпоинты API находятся по пути /api/v1 относительно UI.
GITEA_API_URL=http://localhost:3000/api/v1
